begin parameters
  k1 0.1
end parameters
begin molecule types
  A(s~0~1)
end molecule types
begin seed species
  A(s~0) 100
end seed species
begin observables
  Molecules A_tot A()
end observables
begin functions
  f_rate() k1 * (1 + A_tot)
end functions
begin reaction rules
  A(s~0) -> A(s~1) f_rate()
end reaction rules
