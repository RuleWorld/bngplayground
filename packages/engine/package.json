{
  "name": "@bngplayground/engine",
  "version": "1.0.0",
  "private": true,
  "description": "Pure TypeScript BioNetGen Language (BNGL) simulation engine with ODE, SSA, NFsim, and analysis suite",
  "license": "MIT",
  "author": "RuleWorld <https://github.com/RuleWorld>",
  "repository": {
    "type": "git",
    "url": "https://github.com/RuleWorld/bngplayground.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/RuleWorld/bngplayground#readme",
  "bugs": {
    "url": "https://github.com/RuleWorld/bngplayground/issues"
  },
  "keywords": [
    "bionetgen",
    "bngl",
    "rule-based-modeling",
    "systems-biology",
    "ode-solver",
    "stochastic-simulation",
    "gillespie",
    "nfsim",
    "sensitivity-analysis",
    "sobol",
    "fisher-information",
    "parameter-estimation",
    "sbml",
    "computational-biology"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "antlr4ts": "^0.5.0-alpha.4",
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^4.5.6",
    "jsep": "^1.4.0"
  },
  "devDependencies": {
    "vitest": "^4.0.8"
  }
}
