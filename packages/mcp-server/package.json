{
  "name": "@bngplayground/mcp-server",
  "version": "1.0.0",
  "description": "MCP server for BioNetGen Language modeling with stable and full tool profiles, RuleHub grounding, and MCP Apps",
  "license": "MIT",
  "author": "RuleWorld <https://github.com/RuleWorld>",
  "repository": {
    "type": "git",
    "url": "https://github.com/RuleWorld/bngplayground.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/RuleWorld/bngplayground#readme",
  "bugs": {
    "url": "https://github.com/RuleWorld/bngplayground/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bionetgen",
    "bngl",
    "rule-based-modeling",
    "systems-biology",
    "ai-tools",
    "llm-tools",
    "sensitivity-analysis",
    "parameter-estimation"
  ],
  "type": "module",
  "main": "dist/packages/mcp-server/src/index.js",
  "types": "dist/packages/mcp-server/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/packages/mcp-server/src/index.d.ts",
      "import": "./dist/packages/mcp-server/src/index.js",
      "default": "./dist/packages/mcp-server/src/index.js"
    }
  },
  "bin": {
    "ruleworld-mcp": "./dist/packages/mcp-server/src/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prestart": "npm run build --workspace @bngplayground/rulehub",
    "start": "tsx src/index.ts",
    "predev": "npm run build --workspace @bngplayground/rulehub",
    "dev": "tsx src/index.ts",
    "prebuild": "npm run build --workspace @bngplayground/rulehub",
    "build": "tsc && vite build --config apps/vite.config.ts && node apps/verify-bundle.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@bngplayground/engine": "file:../engine",
    "@bngplayground/rulehub": "file:../rulehub",
    "@modelcontextprotocol/server": "2.0.0",
    "@xenova/transformers": "^2.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@types/node": "^26.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
