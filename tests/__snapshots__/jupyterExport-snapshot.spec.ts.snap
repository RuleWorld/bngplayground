      "source": [
        "## 6. Fisher Information & Sensitivity Analysis
",
        "Estimate the sensitivity of model dynamic responses to parameter changes.",
      ],
    },
    {
      "cell_type": "code",
      "metadata": {
        "language": "python",
      },
      "source": [
        "if rr is None or 'param_name' not in globals():
",
        "    print('Skipping sensitivity analysis: run previous cells first and ensure rr is available.')
",
        "else:
",
        "    def robust_rr_simulate(start, end, points):
",
        "        attempts = [
",
        "            ('cvode', float(start), float(end), int(points)),
",
        "            ('cvode', float(start), float(end), max(51, int(points)//2)),
",
        "            ('rk4', float(start), max(10.0, float(end)*0.5), max(51, int(points)//2)),
",
        "            ('rk4', float(start), max(5.0, float(end)*0.25), max(31, int(points)//4)),
",
        "        ]
",
        "        last_err = None
",
        "        for integrator, s, e, p in attempts:
",
        "            try:
",
        "                rr.setIntegrator(integrator)
",
        "            except Exception:
",
        "                pass
",
        "            try:
",
        "                return rr.simulate(s, e, p)
",
        "            except Exception as err:
",
        "                last_err = err
",
        "        print(f'Sensitivity simulate fallback exhausted: {last_err}')
",
        "        return None
",
        "
",
        "    def get_sensitivity(p_name, delta=0.01):
",
        "        rr.reset()
",
        "        base = float(rr[p_name])
",
        "
",
        "        rr[p_name] = max(1e-12, base * (1 + delta))
",
        "        sim_plus = robust_rr_simulate(0, 100, 101)
",
        "
",
        "        rr.reset()
",
        "        rr[p_name] = max(1e-12, base * (1 - delta))
",
        "        sim_minus = robust_rr_simulate(0, 100, 101)
",
        "        if sim_plus is None or sim_minus is None:
",
        "            return None
",
        "
",
        "        target = observable_names[0] if len(observable_names) > 0 else sim_plus.colnames[1]
",
        "        if target not in sim_plus.colnames:
",
        "            target = sim_plus.colnames[1]
",
        "
",
        "        sens = (sim_plus[target] - sim_minus[target]) / (2 * delta * max(base, 1e-12))
",
        "        return sim_plus['time'], sens, target
",
        "
",
        "    sensitivity_output = get_sensitivity(param_name)
",
        "    if sensitivity_output is None:
",
        "        print('Skipping sensitivity plot: simulation failed for perturbed parameter values.')
",
        "    else:
",
        "        t_vals, sens_vals, target_col = sensitivity_output
",
