begin model
begin parameters
  k_bind 0.386
  k_unbind 0.027
  k_mod 0.135
  A0 141
  B0 57
end parameters

begin molecule types
  A(a~0~1,b)
  B(a~0~1,b~0~1)
end molecule types

begin seed species
  A(a~0,b) A0
  B(a~0,b~0) B0
end seed species

begin observables
  Molecules Total_A A()
  Molecules Active_A A(a~1)
  Molecules Bound_AB A(a!1).B(a!1)
end observables

begin functions
  f_rate() = k_mod * 0.5
end functions

begin reaction rules
  A(a) + B(a) <-> A(a!1).B(a!1) k_bind, k_unbind
  A(a~0) -> A(a~1) f_rate()
end reaction rules
end model
