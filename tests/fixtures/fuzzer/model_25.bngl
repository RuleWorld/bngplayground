begin model
begin parameters
  k_bind 0.313
  k_unbind 0.085
  k_mod 0.112
  A0 137
  B0 65
end parameters

begin molecule types
  A(a,b~0~1)
  B(a~0~1)
  C(a)
end molecule types

begin seed species
  A(a,b~0) A0
  B(a~0) B0
  C(a) 10
end seed species

begin observables
  Molecules Total_A A()
  Molecules Bound_AB A(a!1).B(a!1)
end observables

begin reaction rules
  A(a) + B(a) <-> A(a!1).B(a!1) k_bind, k_unbind
end reaction rules
end model
