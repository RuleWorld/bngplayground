begin model
begin parameters
  k_bind 0.300
  k_unbind 0.013
  k_mod 0.136
  A0 86
  B0 51
end parameters

begin molecule types
  A(a)
  B(a~0~1,b~0~1)
  C(a)
end molecule types

begin seed species
  A(a) A0
  B(a~0,b~0) B0
  C(a) 10
end seed species

begin observables
  Molecules Total_A A()
  Molecules Bound_AB A(a!1).B(a!1)
end observables

begin reaction rules
  A(a) + B(a) <-> A(a!1).B(a!1) k_bind, k_unbind
end reaction rules
end model
