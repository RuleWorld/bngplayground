begin model
begin parameters
  k_bind 0.318
  k_unbind 0.097
  k_mod 0.148
  A0 127
  B0 45
  k_expr 2 * k_bind
end parameters

begin molecule types
  A(a~0~1)
  B(a~0~1,b~0~1)
end molecule types

begin seed species
  A(a~0) A0
  B(a~0,b~0) B0
end seed species

begin observables
  Molecules Total_A A()
  Molecules Active_A A(a~1)
  Molecules Bound_AB A(a!1).B(a!1)
end observables

begin functions
  f_rate() = k_mod * 0.5
end functions

begin reaction rules
  A(a) + B(a) <-> A(a!1).B(a!1) k_bind, k_unbind
  A(a~0) -> A(a~1) f_rate()
end reaction rules
end model
