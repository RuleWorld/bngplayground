begin model
begin parameters
  k_bind 0.329
  k_unbind 0.099
  k_mod 0.066
  A0 67
  B0 58
end parameters

begin molecule types
  A(a)
  B(a~0~1)
end molecule types

begin seed species
  A(a) A0
  B(a~0) B0
end seed species

begin observables
  Molecules Total_A A()
  Molecules Bound_AB A(a!1).B(a!1)
end observables

begin reaction rules
  A(a) + B(a) <-> A(a!1).B(a!1) k_bind, k_unbind
end reaction rules
end model
