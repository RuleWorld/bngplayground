begin model
begin parameters
  k_bind 0.496
  k_unbind 0.062
  k_mod 0.134
  A0 84
  B0 63
end parameters

begin molecule types
  A(a,b)
  B(a)
  C(a)
end molecule types

begin seed species
  A(a,b) A0
  B(a) B0
  C(a) 10
end seed species

begin observables
  Molecules Total_A A()
  Molecules Bound_AB A(a!1).B(a!1)
end observables

begin reaction rules
  A(a) + B(a) <-> A(a!1).B(a!1) k_bind, k_unbind
end reaction rules
end model
