begin model
begin parameters
  k_bind 0.446
  k_unbind 0.053
  k_mod 0.075
  A0 139
  B0 68
end parameters

begin molecule types
  A(a~0~1)
  B(a,b~0~1)
  C(a~0~1)
end molecule types

begin seed species
  A(a~0) A0
  B(a,b~0) B0
  C(a~0) 10
end seed species

begin observables
  Molecules Total_A A()
  Molecules Active_A A(a~1)
  Molecules Bound_AB A(a!1).B(a!1)
end observables

begin functions
  f_rate() = k_mod * 0.5
end functions

begin reaction rules
  A(a) + B(a) <-> A(a!1).B(a!1) k_bind, k_unbind
  A(a~0) -> A(a~1) f_rate()
end reaction rules
end model
