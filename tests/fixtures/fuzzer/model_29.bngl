begin model
begin parameters
  k_bind 0.388
  k_unbind 0.057
  k_mod 0.099
  A0 109
  B0 35
  k_expr 2 * k_bind
end parameters

begin molecule types
  A(a,b)
  B(a,b~0~1)
  C(a)
end molecule types

begin seed species
  A(a,b) A0
  B(a,b~0) B0
  C(a) 10
end seed species

begin observables
  Molecules Total_A A()
  Molecules Bound_AB A(a!1).B(a!1)
end observables

begin reaction rules
  A(a) + B(a) <-> A(a!1).B(a!1) k_bind, k_unbind
end reaction rules
end model
