begin model
begin parameters
  k_bind 0.367
  k_unbind 0.060
  k_mod 0.148
  A0 52
  B0 50
end parameters

begin molecule types
  A(a)
  B(a)
  C(a~0~1)
end molecule types

begin seed species
  A(a) A0
  B(a) B0
  C(a~0) 10
end seed species

begin observables
  Molecules Total_A A()
  Molecules Bound_AB A(a!1).B(a!1)
end observables

begin reaction rules
  A(a) + B(a) <-> A(a!1).B(a!1) k_bind, k_unbind
end reaction rules
end model
