begin model
begin parameters
  k_bind 0.196
  k_unbind 0.066
  k_mod 0.087
  A0 114
  B0 79
end parameters

begin molecule types
  A(a,b)
  B(a~0~1)
  C(a)
end molecule types

begin seed species
  A(a,b) A0
  B(a~0) B0
  C(a) 10
end seed species

begin observables
  Molecules Total_A A()
  Molecules Bound_AB A(a!1).B(a!1)
end observables

begin reaction rules
  A(a) + B(a) <-> A(a!1).B(a!1) k_bind, k_unbind
end reaction rules
end model
