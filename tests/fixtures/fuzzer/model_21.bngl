begin model
begin parameters
  k_bind 0.487
  k_unbind 0.078
  k_mod 0.116
  A0 130
  B0 57
  k_expr 2 * k_bind
end parameters

begin molecule types
  A(a)
  B(a~0~1,b)
end molecule types

begin seed species
  A(a) A0
  B(a~0,b) B0
end seed species

begin observables
  Molecules Total_A A()
  Molecules Bound_AB A(a!1).B(a!1)
end observables

begin reaction rules
  A(a) + B(a) <-> A(a!1).B(a!1) k_bind, k_unbind
end reaction rules
end model
