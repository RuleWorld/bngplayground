{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"],
      "@bngplayground/engine": ["packages/engine/src/index.ts"],
      "@bngplayground/engine/*": ["packages/engine/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "../src/**/*.ts",
    "../packages/**/*.ts"
  ]
}